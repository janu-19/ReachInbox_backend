# Express Server Port
PORT=5000

# Database Connection (MySQL via Prisma)
# Matches mysql service credentials configured in root docker-compose.yml
DATABASE_URL="mysql://scheduler_user:scheduler_password_123@localhost:3307/email_scheduler"

# Redis Connection (BullMQ Storage backend)
REDIS_URL="redis://localhost:6379"

# Ethereal Email SMTP Credentials (generate at https://ethereal.email/)
ETHEREAL_USER="placeholder@ethereal.email"
ETHEREAL_PASS="placeholder_pass"

# Google Authentication
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Session JWT Security
JWT_SECRET="super_secret_jwt_key_change_me_in_production"

# Queue Worker Concurrency (Number of concurrent email sending tasks)
WORKER_CONCURRENCY=5

# Rate Limiting configuration
MAX_EMAILS_PER_HOUR=100
DEFAULT_DELAY_SECONDS=2
